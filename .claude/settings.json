{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(.git/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(.terraform/**)",
      "Read(*.tfstate*)",
      "Read(*.tfplan)",
      "Read(*.tfvars)",
      "Read(*.tfvars.json)"
    ]
  }
}
